# ─────────────────────────────────────────────────────────────────────────────
# JURIS — Environment Configuration Template
#
# Copy this file to .env and fill in real values.
# .env must NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
JURIS_ENV=development
# Options: development | staging | production

JURIS_VERSION=0.2.0

JURIS_DEBUG=true
# Set to false in staging/production.

# ── API ──────────────────────────────────────────────────────────────────────
JURIS_API_PREFIX=
# Optional API prefix (e.g. /api/v1). Leave empty to mount routes at root (/chat).

JURIS_ALLOWED_ORIGINS_RAW=http://localhost
# Comma-separated list of allowed CORS origins for LED Flutter web builds.
# Example: https://app.lawyersediary.com,http://localhost:3000

# ── Model Gateway ────────────────────────────────────────────────────────────
JURIS_GATEWAY=echo
# Which model gateway to use.
# Options: echo (no model, dev only)
# Future: gemini | openai | self_hosted

# Model API keys go here — never hardcode them in source.
# JURIS_GEMINI_API_KEY=

# ── LED Integration ───────────────────────────────────────────────────────────
# JURIS_LED_API_URL=https://api.lawyersediary.com
# The LED backend URL JURIS may call when authorized.
# Leave blank until the LED↔JURIS integration phase.

# ── eCourts (read-only) ───────────────────────────────────────────────────────
# JURIS_ECOURTS_BASE_URL=https://services.ecourts.gov.in
# JURIS_ECOURTS_API_KEY=
# eCourts integration is read-only. JURIS must never write to eCourts.

# ── Firebase / Auth ───────────────────────────────────────────────────────────
JURIS_AUTH_MODE=dev
# Options: dev | firebase
# In production/staging, this must be set to "firebase".

JURIS_DEV_ALLOW_UNAUTHENTICATED=true
# If true and JURIS_ENV=development, calls without Authorization header get a dev user.
# Set to false to test strict 401 unauthenticated flows locally.
# Ignored in production/staging (strictly enforced).

JURIS_FIREBASE_PROJECT_ID=
# Required when JURIS_AUTH_MODE=firebase.

